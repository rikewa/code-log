#------functions:
def center_glyph(penData):
    points = []

    for befehl, punkte in penData:
        for pt in punkte:
            points.append(pt)

    x_punkte = []

    for punkt in points:
        x = punkt[0]
        x_punkte.append(x)

    min_x = min(x_punkte)
    max_x = max(x_punkte)

    return min_x, max_x


def draw_shape(canvas1, p1, p2, center_x):
    x1, y1 = transform(p1, center_x)
    x2, y2 = transform(p2, center_x)

    mode = shape_choice.get()

    if mode == 'line':
        return canvas1.create_line(x1, y1, x2, y2, smooth = True, joinstyle = 'round', capstyle='round', fill='#00ff00')
    elif mode == 'oval':
        return canvas1.create_oval(x1, y1, x2, y2 )
    elif mode == 'rect':
        return canvas1.create_rectangle(x1, y1, x2, y2 )
    
def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, center_x, scale=0.35, offset_x=180, offset_y=300):
    x,y = pt
    x -= center_x
    y =-y

    x*=scale
    y*=scale

    x+=offset_x
    y+=offset_y
    return x,y

def draw_glyph(canvas1, penData):
    global original_points
    original_points = []

    canvas1.delete('all')
    min_x, max_x = center_glyph(penData)
    center_x = (min_x + max_x)/2
    current=None
    starting = None
    lines=[]

    if not penData:
        return
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]

            pt1 = transform(current, center_x)
            pt2 = transform(new, center_x)

            line_id = draw_shape(canvas1, current, new, center_x)
            lines.append(line_id)

            original_points.append(pt1)
            original_points.append(pt2)

            current=new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            prev = current
            steps = 30
            for i in range(1, steps+1):
                progress = i/steps
                curve_point = cubic_bezier(current, p1, p2, p3, progress)
                pt = transform(curve_point, center_x)
                line_id = draw_shape(canvas1, prev, curve_point, center_x)
                lines.append(line_id)
                original_points.append(pt)
                prev = curve_point
            current = p3
        elif befehl == 'closePath':
            if starting is not None and current is not None:
                pt = transform(starting, center_x)
                pt2 = transform(current, center_x)
                line_id = draw_shape(canvas1, current, starting, center_x)
                lines.append(line_id)
                original_points.append(pt)
                original_points.append(pt2)
    for line in lines:
        canvas1.itemconfig(line, width=current_width)

    return lines

def render_glyph(character):
    if not character:
        return
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code, cmap.get(ord('a')))
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)

    return pen.value

def split_outline(penData):
    outline =[]
    current = []

    for befehl, punkte in penData:
        if befehl == 'moveTo':
            if current:
                outline.append(current)
            current =[(befehl, punkte)]
        elif befehl == 'closePath':
            current.append((befehl, punkte))
            outline.append(current)
            current=[]
        else:
            current.append((befehl, punkte))

    if current:
        outline.append(current)
    return outline


def fill_glyph(canvas1, outline):
    global original_points
    original_points = []

    canvas1.delete('all')
    if not outline:
        return
    
    penData_punkte = []
    for contour in outline:
        for befehl in contour:
            penData_punkte.append(befehl)
    min_x, max_x = center_glyph(penData_punkte)
    center_x = (min_x + max_x)/2

    all_points =[]

    for kontur in outline:
        points = []
        current = None
        for befehl, punkte in kontur:
            if befehl == 'moveTo':
                current = punkte[0]
                pt = transform(current, center_x)
                points.append(pt)
                original_points.append(pt)
            elif befehl == 'lineTo':
                current = punkte[0]
                pt = transform(current, center_x)
                points.append(pt)
                original_points.append(pt)
            elif befehl == 'curveTo':
                p0 = current 
                p1, p2, p3 = punkte
                steps = 30
                for i in range(1, steps+1):
                    progress = i/steps
                    curve_point = cubic_bezier(p0, p1, p2, p3, progress)
                    pt = transform(curve_point, center_x)
                    points.append(pt)
                    original_points.append(pt)
                current = p3
            elif befehl == 'closePath':
                pass
        
        if not points:
            continue

        if all_points:
            all_points.append(all_points[-1])
            all_points.append(points[0])
        all_points.extend(points)

    flat = []
    for x,y in all_points:
        flat.append(x)
        flat.append(y)

    canvas1.create_polygon(flat, fill='#00ff00',outline='#00ff00', smooth=False, width= current_width)

def distort_points(mouse_x, mouse_y):
    distorted = []
    radius = 300

    for original_x, original_y in original_points:
        dx = original_x - mouse_x
        dy = original_y - mouse_y

        distort = (dx * dx + dy * dy)**0.5
        x,y = original_x, original_y

        if distort < radius:
            force = 1 - (distort/radius)
            x += dx * force * 0.5
            y += dy * force * 0.5
        distorted.append((x,y))

    return distorted
        
def mouse_move(event):
    canvas1.delete('all')
    distorted = distort_points(event.x, event.y)

    flat = []
    for x,y in distorted:
        flat.extend([x,y])
    if current_mode == 'fill':
        canvas1.create_polygon(flat, fill='#00ff00', outline='#00ff00')
    else:
       canvas1.create_line(flat, smooth=True, width=current_width, fill='#00ff00')


