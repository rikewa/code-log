label2 = ttk.Label(frame1, text='city:', style='label1.TLabel')
label2.grid(column=0, row=1, sticky='w')
entry2 = ttk.Entry(frame1, width=30, style='entry1.TEntry',cursor='man')
entry2.grid(column=1, row=1, sticky='we')

label3 = ttk.Label(frame1, text='country:',style='label1.TLabel')
label3.grid(column=0, row=2, sticky='w')
