import tkinter as tk 
from tkinter import ttk 

# pink: #ff00e4 grün:#00ff00


root = tk.Tk()
root.title('scattergories')
root.attributes('-topmost', True)
root.configure(pady=10, padx=10, background= '#00ff00')

def clear_items():
    for i in example_tree.get_children():   
        example_tree.delete(i)

def remove_item():
    items = example_tree.selection()
    for i in items:
        example_tree.delete(i)

def add_item():
    letter = entry1.get()
    city = entry2.get()
    country = entry3.get()
    animal = entry4.get()

    example_tree.insert(parent='', index='end', text=letter, values=(city, country, animal))
    entry1.delete(0, tk.END)
    entry2.delete(0, tk.END)
    entry3.delete(0, tk.END)
    entry4.delete(0, tk.END)


#------window settings:
swidth = root.winfo_screenwidth()
sheight = root.winfo_screenheight()

width = int(swidth * 0.22)
height = int(sheight * 0.36)

position_x = int((swidth - width)/2)
position_y = int((sheight - height)/2)

root.geometry(f'{width}x{height}+{position_x}+{position_y}')
root.columnconfigure(0, weight=1)


#----------
#-------style settings:
style = ttk.Style()
style.theme_use('alt')
style.configure('label1.TLabel', background='#00ff00')
style.configure('frame1.TFrame', background='#00ff00')
style.configure('example.Treeview', fieldbackground="#ececed", background='#ececed')
style.configure('button1.TButton', background='#ff00e4', foreground='white', borderwidth = 5, relief='sunken')
style.map('button1.TButton', foreground= [('active', 'black')])
style.configure('entry1.TEntry', fieldbackground='#ececed')


example_tree = ttk.Treeview(root, selectmode='none', height='8', style='example.Treeview', cursor='man')
example_tree.grid(column=0, row=0, columnspan=2, sticky='we')
example_tree.configure(columns=('city', 'country', 'animal'))


#--------headlines 
example_tree.heading('#0', text='letter')
example_tree.heading('city', text='city')
example_tree.heading('country', text='country')
example_tree.heading('animal', text='animal')

#----------colums
example_tree.column('#0', width=50)
example_tree.column('city', width=100)
example_tree.column('country', width=100)
example_tree.column('animal', width=100)

