def switch_tab():
    total = notebook1.index('end')
    currentTab = notebook1.index(notebook1.select())

    for i in range(1, total + 1):
        selectTab = (currentTab + i) % total
#hier werden informationen abgefragt 
        if notebook1.tab(selectTab, 'state') != 'hidden':
            notebook1.select(selectTab)
            root.update_idletasks()
            break

