#building the function:

def run_timer():
    try: 
#hier werden die eingegeben werte (aktuell strings) in Zahlen umgewandelt und multipipliziert (integer)
        timer = int(hour_string.get())*3600+ int(minute_string.get())*60
#sollten keine Zahlen eingegeben sein, fehlermeldung
    except:
#hier noch create Laben einfügen um konsolen-ausgabe zu umgehen
        print('incorrect values')
        return

#jetzt beginnt die eigentliche countdown funktion: 
# countdown-funktion inherhalb der funktion
    def countdown():
#nonlocal dient hier als Schlüsselword um die Variable der vorherigen Funktion anzusprechen ohne sie neu definieren zu müssen
        nonlocal timer
#wenn der timer auf 0 spring erscheint die messagebox
        if(timer == 0):
            messagebox.showinfo('', 'time is over!')
            return
#hier werden die eingegeben in integer umgewandelten zahlen zerlegt
#divmod macht 2 dinge: divmod(a,b)
#a = b/a
#b = was bleibt übrig
#ergebnis ist ein Tuple welches 'quotienten' beinhaltet und 'remainder/rest'
        totalHours, remainder = divmod(timer, 3600)
#hier nehme ich den rest der vorheringen rechnung und zerlege ihn weiter 
        totalMinutes, seconds = divmod(remainder, 60)

#eine andere lösung wäre:
#totalHours = timer // 3600
#totalMinutes = (timer % 3600) // 60

        hour_string.set(f'{totalHours:02d}')
        minute_string.set(f'{totalMinutes:02d}')

        timer -= 1
        root.after(1000, countdown)
#funktion schließen    
    countdown()

frame3 =tk.Frame()
frame3.pack(expand=True, pady=10)

timeButton = ttk.Button(frame3, text='set time', width=10, command=run_timer, style='timebutton.TButton')
timeButton.pack(side='bottom')

root.mainloop()