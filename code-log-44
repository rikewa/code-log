#-------functions:
def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, center_x, scale = 0.3, offset_x = 220, offset_y=350):
    x,y = pt
    x -= center_x
    y = -y
    
    x, y = apply_effects((x, y))

    x*= scale
    y*= scale

    x+= offset_x
    y+= offset_y

    return(x,y)

def draw_glyph(canvas1, penData):
    canvas1.delete('all')
    min_x, max_x = get_glyph_bounds(penData)
    center_x = (min_x + max_x) / 2
    current = None
    starting = None 
    lines=[]

    if not penData:
        return
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]
            line_id= canvas1.create_line(transform(current, center_x), transform(new, center_x), joinstyle='round', capstyle='round', fill='#ff00e4')
            lines.append(line_id)
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 50
            prev = current
            for i in range(1, steps+1):
                process = i/steps
                curve_point = cubic_bezier(current, p1, p2, p3, process)
                line_id= canvas1.create_line(transform(prev, center_x), transform(curve_point, center_x),joinstyle='round', capstyle='round',fill='#ff00e4')
                lines.append(line_id)
                prev = curve_point
            current = p3
        elif befehl == 'closePath':
            if starting is not None and current is not None:
                line_id = canvas1.create_line(transform(current, center_x), transform(starting, center_x), joinstyle='round', capstyle='round',fill='#ff00e4')
                lines.append(line_id)

    for line in lines:
        canvas1.itemconfig(line, width=current_width)
    return lines

def render_glyph(character):
    if not character:
        return
    
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code, cmap.get(ord('a')))
    glyph = glyph_set[glyph_name]

    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value



def update_glyph(value):
    global current_width
    current_width = float(value)
    for lines in current_lines:
        canvas1.itemconfig(lines, width=current_width)

def get_glyph_bounds(penData):
    points = []

    for befehl, punkte in penData:
        for pt in punkte:
            points.append(pt)
        
    x_punkte = []
    for p in points:
        x = p[0]
        x_punkte.append(x)
    min_x = min(x_punkte)
    max_y = max(x_punkte)

    return min_x, max_y

#-------effect functions:
def effect(pt):
    x, y = pt
    return x,y

def apply_effects(pt):
    x, y = pt 
    for effect in effects:
        x,y =effect((x,y))
    return(x,y)

def wave_effect(pt):
    x, y = pt
#hier werden die kurven berechnet, sinus von (punkt x * 0.02) (-> wie häufig wiederholen sich die wellen) * 20 (-> bestimmt die höhe der welle)
# math.sin (erzeugt eine sinusförmige bewegung)
# x * wave_freq (bestimmt wie häufig sich die welle wiederholt)
# * wave_strength bestimmt die höhe der welle 
    y += math.sin(x * wave_freq) * wave_strength
    return(x,y)

def noise_effect(pt):
    x, y = pt

    x += random.uniform(-noise_strength, noise_strength)
    y += random.uniform(-noise_strength, noise_strength)
    return(x,y)

def scale_effect(pt):
    x, y = pt
    return (x*scale, y*scale)

effects = [wave_effect, noise_effect, scale_effect]

