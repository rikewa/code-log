    elif tool == 'none':
        canvas1.configure(cursor='hand2')
    

def clear_canvas():
    canvas1.delete('all')
        

def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, scale=0.35, offset_x = 10, offset_y=350):
    x,y= pt
    y = -y

    x *= scale
    y *= scale

    x += offset_x
    y += offset_y

    return(x,y)

def draw_bezier(canvas1, penData):
    canvas1.delete('all')
    current = None
    starting = None
    lines= []

    if not penData:
        return lines
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]
            line_id = canvas1.create_line(transform(current), transform(new), smooth=True, joinstyle='round', capstyle='round', fill='#ff00e4')
            lines.append(line_id)
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 50
            prev = current
            for i in range(1, steps+1):
                process = i/steps
                curve_points = cubic_bezier(current, p1, p2, p3, process)
                line_id= canvas1.create_line(transform(prev), transform(curve_points), smooth=True, joinstyle='round', capstyle='round',fill='#ff00e4')
                lines.append(line_id)
                prev = curve_points
            current =p3
        elif befehl == 'closePath':
            if starting is not None and current is not None:
                line_id = canvas1.create_line(transform(current), transform(starting), smooth=True, joinstyle='round', capstyle='round',fill='#ff00e4')
                lines.append(line_id)
    return lines

def render_glyph(character):
    if not character:
        return
    
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code, cmap.get(ord('a')))
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value

def stroke_update(value):
    global pen_lines
    current_width = float(value)
    for lines in pen_lines:
        canvas1.itemconfig(lines, width=current_width)

def glyph_update(value):
    for lines in glyph_lines:
        canvas1.itemconfig(lines, width=float(value))

def save_img():
    ps = canvas1.postscript(colormode='color')
    img = Image.open(io.BytesIO(ps.encode('utf-8')))
    path = filedialog.asksaveasfilename(defaultextension='png', initialfile='canvas.png', filetypes=[("PNG Datei", "*.png"),("Alle Dateien", "*.*")]  )
    if path:
        img.save(path)

