    for uni_code in cmap.keys():
        try:
            character = chr(uni_code)
            if character == ' ':
                continue
            listbox1.insert(tk.END, character)

        except:
            pass
    listbox1.selection_set(0)
    listbox1.event_generate('<<ListboxSelect>>')

