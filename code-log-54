#---functions:
def center_glyph(penData):
    points = []

    for befehl, punkte in penData:
        for punkt in punkte:
            points.append(punkt)
    
    x_punkte = []
    for pt in points:
        x = pt[0]
        x_punkte.append(x)
    min_x = min(x_punkte)
    max_x = max(x_punkte)

    return(min_x, max_x)

def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, center_x, scale=0.29, offset_x=185, offset_y=280):
    x,y = pt
    x -= center_x
    y = -y

    x *= scale
    y *= scale

    x += offset_x
    y += offset_y

    return x,y 

def draw_glyph(canvas1, penData):
    canvas1.delete('all')
    current = None
    starting = None
    min_x, max_x = center_glyph(penData)
    center_x = (min_x + max_x)/2
    lines = []

    if not penData:
        return lines

    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]
            line_id = canvas1.create_line(transform(current, center_x), transform(new, center_x), fill='#ff00e4')
            lines.append(line_id)
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 40
            prev = current 
            for i in range(1, steps+1):
                progress = i/steps
                curve_point = cubic_bezier(current, p1, p2, p3, progress)
                line_id = canvas1.create_line(transform(prev, center_x), transform(curve_point, center_x),fill='#ff00e4')
                lines.append(line_id)
                prev = curve_point
            current = p3
        elif befehl == 'closePath':
            if starting is not None and current is not None:
                line_id = canvas1.create_line(transform(current, center_x), transform(starting, center_x),fill='#ff00e4')
                lines.append(line_id)
    for line in lines:
        canvas1.itemconfig(line, width = current_width)
    
    return lines

def render_glyph(character):
    if not character or cmap is None:
        return
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code)

    if glyph_name is None:
        return None

    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value

def drawing_action(event):
    input_value = listbox1.get(listbox1.curselection())
    penData = render_glyph(input_value)

    canvas1.delete('all')

    if penData is None:
        canvas1.create_text(100, 100, text='NO GLYPH')

    draw_glyph(canvas1, penData)

def load_font(path):
    global font, font_path, glyph_set, cmap

    try: 
        font_path = path
        font = TTFont(font_path)
        glyph_set = font.getGlyphSet()
        cmap = font.getBestCmap()

        root.title(f'font viewer {os.path.basename(path)}')
        listbox1.event_generate('<<ListboxSelect>>')
        
    except Exception as e: 
          print('fehler', e)

