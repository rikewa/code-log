def dropFile(event):
    global file_path
    file_path = event.data.strip('{}')
    if file_path.lower().endswith(('.otf', '.ttf')):
        font_name = os.path.splitext(os.path.basename(file_path))[0]
        dragLabel.configure(text=font_name)
        load_font(file_path)
        load_list()

dragLabel.dnd_bind('<<Drop>>', dropFile)
