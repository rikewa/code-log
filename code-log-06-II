import tkinter as tk
from tkinter import ttk
from PIL import Image, ImageTk

def say_hello():
    print('hello world!')


root = tk.Tk()
root.geometry('200x200')
root.title(':–)')

image= Image.open('assets/images/logo.png').resize((150,20))
photo= ImageTk.PhotoImage(image)
style =ttk.Style()
style.theme_use('clam')

#button1:
style.configure('button1.TButton', padding='10', background='#00ff00')
style.map('button1.TButton', background=[('active', '#ff00e4'), ('pressed', '#00ff00')])

#button2: 
style.configure('button2.TButton', padding='10', background='#00ff00')
style.map('button2.TButton', background=[('active', '#00ff00'), ('pressed', '#ff00e4')])


#state option zb. für start einer Funktion ab einer bestimmten bedingung
button1 = ttk.Button(root, text='click here', compound='center', cursor='hand2',style='button1.TButton', command=say_hello)
button1.pack()

button2 = ttk.Button(root, text='close :–(',cursor='hand2',style='button2.TButton', command=root.destroy)
button2.pack()


for item in button1.keys():
    print(item, ':', button1[item])


root.mainloop()