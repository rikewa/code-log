style.configure('button2.TButton',relief='sunken', borderwidth=5)
style.map('button2.TButton', background=[('active','#ff00e4')])
style.configure('button3.TButton',relief='sunken', borderwidth=5)
style.map('button3.TButton', background=[('active','black')])
style.configure('TScale', background='white')


