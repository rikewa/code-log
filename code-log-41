def savePos(event):
    global lastx, lasty 
    lastx = event.x
    lasty = event.y

def drawline(event):
    global lastx, lasty
    line_id = canvas1.create_line(lastx, lasty, event.x, event.y, width=current_width, fill = current_color, smooth=True, capstyle="round", joinstyle="round")
    current_lines.append(line_id)

    savePos(event)

def testprint(event):
    print(event.x)
    print(event.y)

def clear():
    canvas1.delete('all')

def change_width(value):
    global current_width
    current_width = float(value)
    for lines in current_lines:
        canvas1.itemconfig(lines, width=current_width)

def set_green():
    global current_color
    current_color = '#00ff00'
    for lines in current_lines:
        canvas1.itemconfig(lines, fill=current_color)
    root.configure(background='#00ff00')
    style.configure('frame2.TFrame', background='#00ff00')

def set_pink():
    global current_color
    current_color = '#ff00e4'
    for lines in current_lines:
        canvas1.itemconfig(lines, fill=current_color)
    root.configure(background='#ff00e4')
    style.configure('frame2.TFrame', background='#ff00e4')

def set_black():
    global current_color
    current_color = 'black'
    for lines in current_lines:
        canvas1.itemconfig(lines, fill=current_color)
    root.configure(background='black')
    style.configure('frame2.TFrame', background='black')
    

#---------gui structure:
canvas1 = tk.Canvas(root, cursor="spraycan")
canvas1.grid(column=0, row=0, sticky='nswe')
canvas1.rowconfigure(0, weight=50)
canvas1.rowconfigure(1, weight=1)

canvas1.bind('<Button-1>', savePos)
canvas1.bind('<B1-Motion>', drawline)

footerFrame = ttk.Frame(root, style='frame1.TFrame')
footerFrame.grid(column=0, row=1, sticky='wes')
