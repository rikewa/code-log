footerFrame.columnconfigure(0, weight=1)
footerFrame.columnconfigure(1, weight=1)
footerFrame.columnconfigure(2, weight=1)
footerFrame.columnconfigure(3, weight=1)

button1 = ttk.Button(footerFrame, text= '', command=set_green, width=8, style='button1.TButton', cursor='hand2')
button1.grid(column=0, row=0, padx=5)

button2 = ttk.Button(footerFrame, text= '', command=set_pink, width=8, style='button2.TButton',cursor='hand2')
button2.grid(column=1, row=0,padx=5, pady=10)

button3 = ttk.Button(footerFrame, text= '', command=set_black, width=8, style='button3.TButton',cursor='hand2')
button3.grid(column=2, row=0,padx=5)

slider1 = ttk.Scale(footerFrame, from_=1, to=20,orient='horizontal', command=change_width, style='TScale',cursor='hand2')
slider1.set(1)
slider1.grid(column=3, row=0,padx=5)

footer2 = ttk.Frame(root, style='frame2.TFrame')
footer2.grid(column=0, row=2, sticky='we', pady=10)
