positoin_y = int((sheight - height)/2)

root.geometry(f'{width}x{height}+{position_x}+{positoin_y}')
root.columnconfigure(0, weight=1)
root.rowconfigure(0, weight=1)
root.rowconfigure(1, weight=0)
root.rowconfigure(2, weight=0)

#-------style settings:
style = ttk.Style()
style.theme_use('alt')
style.configure('frame1.TFrame', background='')
