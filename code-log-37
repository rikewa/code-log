#------functions:
def scale_steps(val):
    value = float(val)
    step_value= round(value/0.2)*0.2
    step_var.set(step_value)
    draw_button()
    

def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, scale=0.35 , offset_x=10, offset_y=350):
    x,y = pt
    y = -y

    x *= scale
    y *=scale

    x += offset_x
    y += offset_y

    return(x,y)

def draw_glyph(canvas1, penData):
    canvas1.delete('all')
    current = None
    start_point = None

    if not penData:
        return

    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            start_point = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]
            canvas1.create_line(transform(current), transform(new))
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = int(step_var.get())
            prev = current
            for i in range(1, steps+1):
                progress = i/steps
                curve_point = cubic_bezier(current, p1, p2, p3, progress)
                canvas1.create_line(transform(prev), transform(curve_point))
                prev = curve_point
            current = p3
        elif befehl == 'closePath':
            if start_point is not None and current is not None:
                canvas1.create_line(transform(current), transform(start_point))
            current = start_point
        
def render_glyph(character):
    if not character:
        return
# character holt sich hier das erste zeichen was an die funktion übergeben wird und wandelt 
# es in den unicode code-point um zb. A -> 65
    uni_code = ord(character[0])
# cmap ist die liste der character aus der verknüpften font-datei. Hier wird sich der entsprechende character mithilfe des Unicodes
# geholt, 'a' dient als default, falls uni_code ungültig
    glyph_name = cmap.get(uni_code, cmap.get(ord('a')))
# hier wird sich die glyphe aus dem glyph set geholt (siehe oben glyph_set)
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value

def show_data(character):
    if not show_data:
        return
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code, 'unknown')
    info_var.set(f'{character} | {glyph_name} | {uni_code} [unicode]')


