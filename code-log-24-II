import tkinter as tk 
from tkinter import ttk

# pink: #ff00e4 grün:#00ff00


root = tk.Tk()
root.title('title')
root.attributes('-topmost', True)
root.configure(pady=10, padx=10, background='#ff00e4')

#---------functions:
def change_option():
    combobox1.configure(values=('Januar', 'Februar'))

def handle_selection(event):
    print('Current Day: ' + day.get())
    print(combobox1.current())

#----------window settings:
swidth = root.winfo_screenwidth()
sheight = root.winfo_screenheight()

width = int(swidth * 0.2)
height = int(sheight * 0.2)

position_x = int((swidth - width)/2)
position_y = int((sheight - height)/2)
root.geometry(f'{width}x{height}+{position_x}+{position_y}')

#------root structure:
root.columnconfigure(0, weight=1)

day = tk.StringVar()
day.set('choose option')

combobox1 = ttk.Combobox(root, width=20, textvariable=day, state='readonly', justify='center')
combobox1.configure(values=(':)',':-)', ':--)', ':---)', ':----)', ':-----)'), justify='center')
combobox1.grid(column=0, row=0)

combobox1.bind('<<ComboboxSelected>>', handle_selection)


#--------programm start:
root.mainloop()