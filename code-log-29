#------style settings:
style = ttk.Style()
style.theme_use('alt')
style.configure('dropdown.TMenubutton', bg = '#ff00e4')
style.map('dropdown.TMenubutton', background=[('active','#00ff00')])

#----canvas
canvas = tk.Canvas(root, bg='#00ff00')
canvas.pack(fill='x', expand=True, ipady=5)

canvas.create_oval((100,100,50,50), fill='#00ff00', width=5, dash= (2,1,1,1), outline='#ff00e4')
canvas.create_oval((10,10,50,50), fill='#00ff00', width=5, dash= (2,1,1,1), outline='#ff00e4')
canvas.create_line((10,10,50,50), fill='#ff00e4')
canvas.create_polygon((150,150,100,200,140,70), fill = '#ff00e4')
canvas.create_oval((200,200,300,100), fill='blue')
canvas.create_arc((200,200,300,100), fill='#ff00e4', start=100, extent = 180, style= tk.CHORD, outline = '#ff00e4', width=10)

canvas.create_text((100,100), text='this is text', fill='blue', width=30 )

#------program start:
root.mainloop()