#------ functions:
def center_glyph(penData):
    points = []
    for befehl, punkte in penData:
        for p in punkte:
            points.append(p)
    
    x_punkte = []
    
    for punkte in points:
        x = punkte[0]
        x_punkte.append(x)
    min_x = min(x_punkte)
    max_x = max(x_punkte)
    return min_x, max_x

def draw_shape(pt, p1, p2, center_x, offset_x = 0, offset_y = 0):
    x1, y1 = transform(p1, center_x, offset_x = offset_x , offset_y = offset_y)
    x2, y2 = transform(p2, center_x, offset_x = offset_x , offset_y = offset_y)

    offset = int(polygon_offset.get())
    mode = shape_var.get()

    if mode == 'line':
        return canvas1.create_line(x1, y1, x2, y2, smooth=True, joinstyle='round', capstyle='round', fill='#ff00e4')
    elif mode == 'parallel':
        return canvas1.create_line(x1 - offset, y1 - offset, x2 + offset, y2 + offset, fill='#ff00e4')
    elif mode == 'oval':
        return canvas1.create_oval(x1 - offset, y1 - offset, x2 + offset, y2 + offset, outline='#ff00e4')
    elif mode == 'rectangle':
        return canvas1.create_rectangle(x1 - offset, y1 - offset, x2 + offset, y2 + offset, outline='#ff00e4')
    elif mode == 'polygon':
        return canvas1.create_polygon(x1, y1, x2, y2,x2+offset, y2+offset, fill='#ff00e4')

def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, center_x, scale=0.2, offset_x=0, offset_y=0):
    x,y = pt
    x -= center_x
    y = -y

    x *= scale
    y *= scale

    x += offset_x
    y += offset_y

    return x,y

def draw_glyph(canvas1, penData, offset_x=0, offset_y=0):
    min_x, max_x = center_glyph(penData)
    center_x = (min_x + max_x)/2
    current = None
    starting = None
    lines = []

    if not penData:
        return
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        if befehl == 'lineTo':
            new = punkte[0]
            line_id = draw_shape(canvas1, current, new, center_x, offset_x, offset_y)
            lines.append(line_id)
            current = new
        if befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = int(step_var.get())
            prev = current
            for i in range(1, steps+1):
                progress = i/steps
                curve_points = cubic_bezier(current, p1, p2, p3, progress)
                line_id = draw_shape(canvas1, prev, curve_points, center_x, offset_x, offset_y)
                lines.append(line_id)
                prev = curve_points
            current = p3
        elif befehl == 'closePath':
            if starting is not None and current is not None:
                line_id = draw_shape(canvas1, current, starting, center_x, offset_x, offset_y)
                lines.append(line_id)

    for line in lines:
        canvas1.itemconfig(line, width = current_width)

    return lines
    
def render_glyph(character):
    if not character:
        return
    
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code, cmap.get(ord('a')))
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value

def draw_text(text):
    global current_lines, line_height
    current_lines = []
    x_start = 110
    y_start = 210

    for character in text:
        if character == '|':
            x_start = 100
            y_start += line_height
            continue

        penData = render_glyph(character)
        if not penData:
            continue
        glyph_name = cmap.get(ord(character), cmap.get(ord('a')))
        advanced_width, _ = font['hmtx'][glyph_name]
        lines = draw_glyph(canvas1, penData, offset_x=x_start, offset_y=y_start)
        current_lines.extend(lines)

        x_start += advanced_width * spacing

def update_spacing(value):
    global spacing
    spacing = float(value)
    drawing_button()

def update_line_height(value):
    global line_height
    line_height = float(value)
    drawing_button()

def update_steps(value):
    value = float(value)
    step_value = round(value/0.2)*0.2
    step_var.set(step_value)
    drawing_button()

