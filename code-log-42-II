import tkinter as tk 
from tkinter import ttk 
from fontTools.ttLib import TTFont
from PIL import Image
import io
from tkinter import filedialog

# pink: #ff00e4 grün:#00ff00

root = tk.Tk()
root.attributes('-topmost',True)
root.title('')
root.configure(pady=10, padx=10, background='#ff00e4')

#--------variables
tool_choice = tk.StringVar()
tool_choice.set('none')
current_lines = []

current_width = 1

#-------window settings:
swidth = root.winfo_screenwidth()
sheight = root.winfo_screenheight()

width = int(swidth*0.2)
height = int(sheight * 0.3)

position_x = int((swidth - width)/2)
position_y = int((sheight - height)/2)

root.geometry(f'{width}x{height}+{position_x}+{position_y}')
root.columnconfigure(0, weight=1)
root.rowconfigure(0, weight=0)
root.rowconfigure(1, weight=5)
root.rowconfigure(2, weight=1)

#--------- style settings:
style = ttk.Style()
style.theme_use('alt')
style.configure('frame1.TFrame', background='#ff00e4')


#-------font settings:
font_path = 'assets/fonts/artificiel-testing.otf'

font = TTFont(font_path)
glyph_set = font.getGlyphSet()
cmap = font.getBestCmap()

#----------- functions:
def savePos(event):
    global lastx, lasty 
    lastx = event.x
    lasty = event.y

def tool(event):
    global lastx, lasty
    tool = tool_choice.get()

    if tool == 'pen':
        canvas1.configure(cursor='spraycan')
        line_id= canvas1.create_line(lastx, lasty, event.x, event.y, fill='#ff00e4', width=current_width, smooth=True, capstyle='projecting', joinstyle='bevel')
        current_lines.append(line_id)
        savePos(event)

    elif tool == 'none':
        canvas1.configure(cursor='hand2')

def clear():
    canvas1.delete('all')

def save_img():
    ps = canvas1.postscript(colormode='color')
    img = Image.open(io.BytesIO(ps.encode('utf-8')))
    path = filedialog.asksaveasfilename(defaultextension='.png', initialfile="canvas.png",filetypes=[("PNG Datei", "*.png"),("Alle Dateien", "*.*")])

    if path:
        img.save(path)

def change_border(value):
    global current_width
    current_width = float(value)
    for lines in current_lines:
        canvas1.itemconfig(lines, width=current_width)

#---------GUI structure
toolbar= ttk.Frame(root)
toolbar.grid(column=0, row=0, sticky='nswe')
toolbar.columnconfigure(0, weight=1)
toolbar.columnconfigure(1, weight=1)
toolbar.columnconfigure(2, weight=1)

slider1 = ttk.Scale(toolbar, orient='horizontal', from_=1, to=40, command=change_border, style='TScale')
slider1.set(1)
slider1.grid(column=0, row=0, padx=10, pady=10)

radiobutton1 = ttk.Radiobutton(toolbar, text='pen', value='pen', variable=tool_choice, style='button1.TRadiobutton')
radiobutton1.grid(column=1, row=0, padx=10)

radiobutton2 = ttk.Radiobutton(toolbar, text='none', value='none', variable=tool_choice, style='button1.TRadiobutton')
radiobutton2.grid(column=2, row=0, padx=10)

canvas1 = tk.Canvas(root, cursor='hand2')
canvas1.grid(column=0, row=1, sticky='nswe')

canvas1.bind('<Button-1>', savePos)
canvas1.bind('<B1-Motion>', tool)

frame1 = ttk.Frame(root, style='frame1.TFrame')
frame1.grid(column=0, row=2, pady=10)
frame1.columnconfigure(0, weight=1)
frame1.columnconfigure(1, weight=1)


