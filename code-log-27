#-----------root structure:

#----------Menu:
#application_menu = tk.Menu(root)
#root.configure(menu=application_menu)
menu_button = ttk.Menubutton(root, text='background', direction='below')
menu_button.pack(pady=10)

program_menu = tk.Menu(menu_button)
menu_button.configure(menu=program_menu)
# label beschriftet den menüpunkt, menu= welches menu soll angezeigt werden?
#application_menu.add_cascade(label='background', menu=program_menu)
