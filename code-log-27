import tkinter as tk 
from tkinter import ttk
from PIL import Image, ImageTk

# pink: #ff00e4 grün:#00ff00

root = tk.Tk()
root.title('gallery')
root.attributes('-topmost', True)
root.configure(padx=10, pady=10, background='#00ff00')

color_var = tk.StringVar(value='#00ff00')

#-------funkctions:
def change_color():
    color = color_var.get()
    root.configure(bg= color)
    style.configure('label1.TLabel', background=color)
    #style.configure('My.TPanedwindow', background=color)
    #style.configure('frames.TFrame', background=color)

#--------window settings:
swidth = root.winfo_screenwidth()
sheight = root.winfo_screenheight()

width = int(swidth * 0.2)
height = int(sheight * 0.3)

position_x = int((swidth - width)/2)
position_y = int((sheight - height)/2)
root.geometry(f'{width}x{height}+{position_x}+{position_y}')

#-------style settings:
style = ttk.Style()
style.theme_use('classic')
style.configure('label1.TLabel', background='#00ff00')
