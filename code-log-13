#---------timer funktion

def run_timer():
    global timer, timer_running

    errorlabel.configure(text='')

    if timer == 0:
        try:
            timer = int(hourstring.get())*3600 + int(minutestring.get())*60 + int(secondstring.get())
        except:
            errorlabel.configure(text='invalid value')

            hourstring.set('00')
            minutestring.set('60')
            secondstring.set('00')
            return

        if timer==0:
            messagebox.showinfo('','time is over')
            timer_running=None

            hourstring.set('00')
            minutestring.set('60')
            secondstring.set('00')
            return

    def countdown():
        global timer_running, timer

        timer-=1

        totalhour, remainer = divmod(timer, 3600)
        totalminute, seconds = divmod(remainer, 60)
        totalsecond = seconds

        hourstring.set(f'{totalhour:02d}')
        minutestring.set(f'{totalminute:02d}')
        secondstring.set(f'{totalsecond:02d}')

        if (timer == 0):
            messagebox.showinfo('','time is over')
            timer_running=None

            hourstring.set('00')
            minutestring.set('60')
            secondstring.set('00')
            return
        
        timer_running = root.after(1000, countdown)
    countdown()

def stop_timer():
    global timer_running, timer
    
    if timer_running is not None:
        root.after_cancel(timer_running)
        timer_running=None
    
    timer=0

    hourstring.set('00')
    minutestring.set('60')
    secondstring.set('00')
    return

def pause_timer():
    global timer_running
    
    if timer_running is not None:
        root.after_cancel(timer_running)
        timer_running=None


