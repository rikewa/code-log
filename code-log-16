def say_age():
        try:
            age = int(ageEntry.get())

            if age > 25: 
                agetext = str(age) + '???? ' + 'you look younger!'
            elif age < 25:
                agetext = str(age) + ' ???? ' + 'you are a baby!'
            else:
                agetext = "that's a quater of 100."
                 
            ageResult.configure(text=agetext)

        except:
            ageResult.configure(text="that's not a number")
            return
        
