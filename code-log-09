import tkinter as tk
from tkinter import ttk

root = tk.Tk()
root.attributes('-topmost', True)
root.title('title')

style = ttk.Style()
style.theme_use('clam')

swidth = root.winfo_screenwidth()
sheight = root.winfo_screenheight()

width = int(swidth * 0.2)
height = int(sheight * 0.2)

position_x = int((swidth-width) /2 )
position_y = int((sheight-height) /2 )

root.geometry(f'{width}x{height}+{position_x}+{position_y}')
 # pink: #ff00e4 grün:#00ff00
root.configure(background='blue')

style.configure('button1.TButton', background='#00ff00')
style.map('button1.TButton', background=[('active','#ff00e4')])

style.configure('button2.TButton', background='#ff00e4')
style.map('button2.TButton', background=[('active','#00ff00')])

label1= tk.Label(root, text='hello world', background='#ff00e4')
label1.pack(side='left', fill='both', expand=True, padx=5 , pady=7)

button1 = ttk.Button(label1, text='button 1', style='button1.TButton', width=int(swidth * 0.005))
button1.pack(side='bottom', pady=10)

label2= tk.Label(root, text='hallo welt!', background='#00ff00')
label2.pack(side='left', fill='both', expand=True, padx=5, pady=7)

button2 = ttk.Button(label2, text='button 2', style='button2.TButton', width=int(swidth * 0.005))
button2.pack(side='bottom', pady=10)

#programm startet erst durch die methode .mainloop
root.mainloop()

