#-----functions:
def center_glyph(penData):
    points = []

    for befehl, punkte in penData:
        for pt in punkte:
            points.append(pt)

    x_punkte =[]
    for p in points:
        x = p[0]
        x_punkte.append(x)
    min_x = min(x_punkte)
    max_x = max(x_punkte)
    return(min_x, max_x)

def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, center_x, scale= 0.2, offset_x=100, offset_y=200):
    x,y = pt
    x-= center_x
    y = -y

#    x,y = apply_effects((x,y))

    x*=scale
    y*= scale

    x+=offset_x
    y+=offset_y

    return(x,y)

def draw_shape(canvas1, p1, p2, center_x):
    x1, y1 = transform(p1, center_x)
    x2, y2 = transform(p2, center_x)

    mode = shape_choice.get()

    if mode == 'line':
        return canvas1.create_line(x1, y1, x2, y2, smooth=True, joinstyle = 'round', capstyle='round')
    elif mode == 'stripes':
        return canvas1.create_line(x1, y1, x2, y2)
    elif mode == 'oval':
        r = 3
        return canvas1.create_oval(x1-r, y1-r, x1+r, y1+r)
#        return canvas1.create_oval(x1, y1, x2, y2)
    elif mode == 'rect':
        return canvas1.create_rectangle(x1, y1, x2, y2)
    elif mode == 'poly':
        offset = int(polygon_offset.get())
        return canvas1.create_polygon(x1, y1, x2, y2, x1 + offset, y1+ offset)

def draw_glyph(canvas1, penData):
    canvas1.delete('all')
    min_x, max_x = center_glyph(penData)
    center_x = (min_x + max_x)/2
    current = None
    starting = None
    lines=[]

    if not penData:
        return
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]
            line_id = draw_shape(canvas1, current, new, center_x)
            lines.append(line_id)
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 30
            prev = current
            for i in range(1, steps+1):
                progress = i/steps
                curve_points = cubic_bezier(current, p1, p2, p3, progress)
                line_id = draw_shape(canvas1, prev, curve_points, center_x)
                lines.append(line_id)
                prev = curve_points
            current = p3
        elif befehl == 'closePath':
            if starting is not None and current is not None:
                line_id = draw_shape(canvas1, current, starting, center_x)
                lines.append(line_id)
    
    for line in lines:
        canvas1.itemconfig(line, width=current_width)
    return lines

def render_glyph(character):
    if not character:
        return
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code, cmap.get(ord('a')))
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value

