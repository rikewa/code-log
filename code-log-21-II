#-------functions:
def unlock(text, s):
    result = ''
# hier wird für die länge des eingegebenen textes eine schleife erstellt
    for i in range(len(text)):
        char = text[i]
        if char == ' ' or char == '.' or char == '?' or char == 'ß' or char == 'ö' or char == 'ä' or char == 'ü' or char == 'Ä'or char == 'Ü' or char == 'Ö' or char == '!' or char == ','or char == '4':
            result += char
        elif char.isupper():
            result += chr((ord(char) + s - 65)% 26 + 65)
        else:
            result += chr((ord(char) + s - 97)% 26 + 97)
    return result 

def lock(text, s):
    result = ''
# hier wird für die länge des eingegebenen textes eine schleife erstellt
    for i in range(len(text)):
        char = text[i]
        if char == ' ' or char == '.' or char == '?' or char == 'ß' or char == 'ö' or char == 'ä' or char == 'ü' or char == 'Ä'or char == 'Ü' or char == 'Ö' or char == '!' or char == ',' or char == '4':
            result += char
        elif char.isupper():
            result += chr((ord(char) - s - 65)% 26 + 65)
        else:
            result += chr((ord(char) - s - 97)% 26 + 97)
    return result 

def save_option():
    if selected_option.get() == 'lock':
        locked_input = lock(enterText.get("1.0", "end").strip(), int(passwordEntry.get()))
        secretLabel.delete(0, tk.END)
        secretLabel.insert(0, locked_input)
    elif selected_option.get() == 'unlock':
        unlocked_input = unlock(enterText.get("1.0", "end").strip(), int((passwordEntry.get())))
        secretLabel.delete(0, tk.END)
        secretLabel.insert(0, unlocked_input)
    else:
        print('fehler')
        return
    

def copy_paste():
    enterText.delete('1.0', tk.END)
    passwordEntry.delete(0, tk.END)
    enterText.insert('1.0', secretLabel.get())
    secretLabel.delete(0, tk.END)

