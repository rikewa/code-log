import tkinter as tk 
from tkinter import ttk
import random

# pink: #ff00e4 grün:#00ff00

root = tk.Tk()
root.title('HELLO')
root.attributes('-topmost', True)
root.configure(background='#ff00e4', padx=9, pady=9)

coordinates = tk.StringVar()
size = tk.StringVar()

#-----------functions:
def show_size(event):
    size.set(f"{event.width} x {event.height}")

def show_coordinates(event):
    coordinates.set(str(event.x_root) + ' ' + str(event.y_root))


def show_label(event1):
#    print(f'Breite: {event.width}')
 #   print(f'Höhe: {event.height}')

    x = random.uniform(0, 0.9)
    y = random.uniform(0, 0.9)

    showLabel = ttk.Label(frame1, text='HELLO')
    showLabel.place(relx = x, rely = y)
    label1.lift()
    label4.lift()

def handle_event(event2):
    x = random.uniform(0, 0.9)
    y = random.uniform(0, 0.9)

    surprise = ttk.Label(frame1, text=':––)', style='label4.TLabel')
    surprise.place(relx = x, rely = y)
    label4.lift()
    label1.lift()



#--------- window settings:
swidth = root.winfo_screenwidth()
sheight = root.winfo_screenheight()

width = int(swidth * 0.15)
height = int(sheight * 0.3)

position_x = int((swidth - width)/2)
position_y = int((sheight - height)/2)

root.geometry(f'{width}x{height}+{position_x}+{position_y}')
#----------------------------

#---------style settings:
style = ttk.Style()
style.theme_use('alt')
style.configure('frame1.TFrame')
style.configure('label1.TLabel', background='#00ff00')
style.configure('label4.TLabel', background='#ff00e4')
style.configure('button1.TButton', anchor='center', relief='sunken', borderwidth=8)
#------------------------

#-------------window structure:
frame1 = ttk.Frame(root, style='frame1.TFrame')
frame1.place(relx=0.5, rely=0.5, relwidth=1, relheight=1, anchor='center')

label1= ttk.Button(frame1, text='come closer', style='button1.TButton', cursor='hand2')
label1.place(relx = 0.5, rely= 0.5, relwidth=0.5, relheight=0.15, anchor='center')

label2= ttk.Label(root, textvariable=coordinates, anchor='center', style='label4.TLabel')
label2.place(relx=0, rely=0.93, relheight=0.1, relwidth=0.5)

label3= ttk.Label(root, textvariable=size, anchor='center', style='label4.TLabel')
label3.place(relx=0.5, rely=0.93, relheight=0.1, relwidth=0.55)

label4 = ttk.Label(frame1, text='click for ????', anchor='center', style='label1.TLabel', cursor='hand2')
label4.place(relx=0, rely=0, relwidth=1, relheight=0.1)


#--------events:
label4.event_add('<<CustomEvent>>', '<Button-1>')
label4.bind('<<CustomEvent>>', handle_event)

label1.bind('<Motion>', show_label)
root.bind('<Motion>', show_coordinates)
root.bind('<Configure>', show_size)
#-----------------

#-------------------program start:
root.mainloop()
