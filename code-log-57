#-----export (AI Help):
def generate_svg(character):
    penData = render_glyph(character)

    if not penData:
        return None

    min_x, max_x = center_glyph(penData)
    center_x = (min_x + max_x) / 2

    offset_value = offset_var.get()
    mode = shape_choice.get()

    svg_elements = []

    current = None
    starting = None

    def svg_segment(p1, p2):
        x1, y1 = transform(p1, center_x)
        x2, y2 = transform(p2, center_x)
        if mode == 'vector':
            svg_elements.append(
                f'<line x1="{x1:.1f}" y1="{y1:.1f}" '
                f'x2="{x2:.1f}" y2="{y2:.1f}" '
                f'stroke="black" stroke-width="1"/>'
            )
        elif mode == 'oval':
            svg_elements.append(
                f'<ellipse '
                f'cx="{(x1+x2)/2:.1f}" '
                f'cy="{(y1+y2)/2:.1f}" '
                f'rx="{abs(x2-x1)/2+offset_value:.1f}" '
                f'ry="{abs(y2-y1)/2+offset_value:.1f}" '
                f'stroke="black" fill="none"/>'
            )
        elif mode == 'rectangle':
            lx = min(x1, x2) - offset_value
            ty = min(y1, y2) - offset_value
            rx = max(x1, x2) + offset_value
            by = max(y1, y2) + offset_value

            svg_elements.append(
                f'<rect '
                f'x="{lx:.1f}" '
                f'y="{ty:.1f}" '
                f'width="{rx-lx:.1f}" '
                f'height="{by-ty:.1f}" '
                f'stroke="black" fill="none"/>'
            )

    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]
            svg_segment(current, new)
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = int(step_var.get())
            prev = current

            for i in range(1, steps + 1):
                progress = i / steps
                curve_point = cubic_bezier(current, p1, p2, p3, progress)
                svg_segment(prev, curve_point)
                prev = curve_point
            current = p3

        elif befehl == 'closePath':
            if starting and current:
                svg_segment(current, starting)

    w = canvas1.winfo_width()
    h = canvas1.winfo_height()

    svg = (
        f'<svg xmlns="http://www.w3.org/2000/svg" '
        f'width="{w}" height="{h}">\n'
    )

    svg += '\n'.join(svg_elements)
    svg += '\n</svg>'
    return svg

def create_unique_export_dir(category, prefix):
    project_dir = os.path.dirname(os.path.abspath(__file__))
    base_dir = os.path.join(project_dir, 'exports',category)
    os.makedirs(base_dir, exist_ok=True)
    counter = 1

    while True:
        folder_name = f'{prefix}-{counter}'
        export_dir = os.path.join(base_dir, folder_name)
        if not os.path.exists(export_dir):
            os.makedirs(export_dir)
            return export_dir
        counter += 1

def export_svg():
    selection = glyphlist.curselection()
    if not selection:
        return

    character = glyphlist.get(selection[0])
    svg = generate_svg(character)
    if svg is None:
        return

    export_dir = create_unique_export_dir('single','export')
    mode = shape_choice.get()
    char_name = (character if character.isascii() else f'u{ord(character):04X}')
    export_path = os.path.join(export_dir, f'{char_name}_{mode}.svg')

    with open(export_path, 'w', encoding='utf-8') as f:
        f.write(svg)

    print('exported:', export_path)

def export_all_svgs():
    export_dir = create_unique_export_dir('glyph-set','set')
    mode = shape_choice.get()
    for uni_code in cmap.keys():

        try:
            character = chr(uni_code)
            if character == ' ':
                continue
            svg = generate_svg(character)
            if svg is None:
                continue

            char_name = (character if character.isascii() else f'u{ord(character):04X}')
            export_path = os.path.join(export_dir, f'{char_name}_{mode}.svg')
            with open(export_path, 'w', encoding='utf-8') as f:
                f.write(svg)
            print('exported:', export_path)

        except Exception as e:
            print('error:', e)
