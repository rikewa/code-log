#-----functions:
def centerGlyph(penData):
    points =[]

    for befehl, punkte in penData:
        for pt in punkte:
            points.append(pt)

    x_punkte=[]

    for p in points:
        x = p[0]
        x_punkte.append(x)
    min_x = min(x_punkte)
    max_x = max(x_punkte)
    return min_x, max_x

def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, center_x, scale=0.3, offset_x = 190, offset_y=350):
    x,y = pt
    x -= center_x
    y = -y

    x *= scale
    y *= scale

    x += offset_x
    y += offset_y

    return x,y

def draw_shape(p1, p2, center_x):
    x1, y1 = transform(p1, center_x)
    x2, y2 = transform(p2, center_x)

    mode = shape_choice.get()
    offset = offset_var.get()

    if mode == 'vector':
        return canvas1.create_line(x1, y1, x2, y2, fill='#ff00e4')
    elif mode == 'oval':
        return canvas1.create_oval(x1 - offset, y1 - offset, x2 + offset , y2 + offset, fill='#ff00e4')
    elif mode == 'polygon':
        return canvas1.create_polygon(x1, y1, x2, y2,x2+offset, y2+offset, fill='#ff00e4')
    elif mode == 'rectangle':
        return canvas1.create_rectangle(x1 - offset, y1 - offset, x2 + offset, y2 + offset, fill='#ff00e4')


def draw_glyph(canvas1, penData):
    canvas1.delete('all')
    current = None
    starting = None
    lines = []
    min_x, max_x = centerGlyph(penData)
    center_x = (min_x + max_x)/2
    

    if not penData:
        return lines
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]
            line_id = draw_shape(current, new, center_x)
            lines.append(line_id)
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = int(step_var.get())
            prev = current
            for i in range(1, steps+1):
                progress = i/steps
                curve_points = cubic_bezier(current, p1, p2, p3, progress)
                line_id = draw_shape(prev, curve_points, center_x)
                lines.append(line_id)
                prev = curve_points
            current = p3
        elif befehl == 'closePath':
            if starting is not None and current is not None:
                line_id = draw_shape(current, starting, center_x)
                lines.append(line_id)
    for line in lines:
        canvas1.itemconfig(line, width=current_width)
    return lines

def render_glyph(character):
    if not character or cmap is None:
        return
    
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code)

    if glyph_name is None:
        return None
    
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value

def drawing_action(event=None):
    global current_lines
    selection = glyphList.curselection()

    if not selection:
        return
    
    input_value = glyphList.get(selection[0])
    penData = render_glyph(input_value)

    if penData is None:
        return canvas1.create_text(100, 100, text='NO GLYPH')

    current_lines=draw_glyph(canvas1, penData)

def load_font():
    global vf, font_path, cmap, glyph_set

    try:
        font_path = 'assets/fonts/Mavis-Variable.otf'
        vf = TTFont(font_path)
        for axis in vf['fvar'].axes:
            print(axis.axisTag)
            print(axis.minValue)
            print(axis.maxValue)

        glyph_set = vf.getGlyphSet()
        cmap = vf.getBestCmap()
    
    except Exception as e:
        print('fehler', e)

def update_steps(value):
    val = float(value)
    step_value = round(val/0.2)*0.2
    step_var.set(step_value)
    drawing_action()

def variable_font(event=None):
    global glyph_set, cmap

    opsz_value = round(variable_value.get())
    variable_value.set(opsz_value)
    instance = instantiateVariableFont(vf, {'opsz': opsz_value }, inplace=False)
    glyph_set = instance.getGlyphSet()
    cmap = instance.getBestCmap()

    drawing_action()

