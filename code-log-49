import tkinter as tk 
from tkinter import ttk 
# pink: #ff00e4 grün:#00ff00

root = tk.Tk()
root.title('following pen')
root.attributes('-topmost', True)
root.configure(background='#ff00e4')

#---variables:
tool_choice = tk.StringVar()
tool_choice.set('pen')
pen_lines=[]
current_width = 3
slider_var = tk.IntVar()
stretch_val = 0.9

#------window settings:
swidth = root.winfo_screenwidth()
sheight = root.winfo_screenheight()

width = int(swidth * 0.3)
height = int(sheight * 0.35)

position_x = int((swidth - width)/2)
position_y = int((sheight - height)/2)

root.geometry(f'{width}x{height}+{position_x}+{position_y}')
root.columnconfigure(0, weight=1)
root.rowconfigure(0, weight=0)
root.rowconfigure(1, weight=5)
root.rowconfigure(2, weight=0)

#-------style settings:
style = ttk.Style()
style.theme_use('alt')
#style.configure('frame1.TFrame', background='#00ff00')
#style.configure('scale1.Horizontal.TScale', background='#ff00e4', troughcolor='#00ff00')

#------------functions
def save_pos(event):
    global lastx, lasty
    lastx = event.x
    lasty = event.y

def draw_shape(event):
    global lastx, lasty, pen_lines
    tool = tool_choice.get()
    stretch = stretch_val

    if tool == 'pen':
        canvas1.configure(cursor='spraycan')
        line_id = canvas1.create_line(lastx, lasty, event.x, event.y, fill='#00ff00', width=current_width, smooth=True, joinstyle='round', capstyle='round')
        pen_lines.append(line_id)
        save_pos(event)
    elif tool == 'oval':
        canvas1.configure(cursor='spraycan')
        line_id = canvas1.create_oval((lastx*stretch), lasty, event.x, event.y, fill='#00ff00', outline='#00ff00',width=current_width)
        pen_lines.append(line_id)
        save_pos(event)
    elif tool == 'rect':
        canvas1.configure(cursor='spraycan')
        line_id = canvas1.create_rectangle((lastx*stretch), lasty, event.x, event.y, fill='#00ff00' ,outline='#00ff00',width=current_width)
        pen_lines.append(line_id)
        save_pos(event)
    elif tool == 'lines':
        canvas1.configure(cursor='spraycan')
        line_id = canvas1.create_line((lastx*stretch), lasty, event.x, event.y, fill='#00ff00',width=current_width)
        pen_lines.append(line_id)
        save_pos(event)
    
    canvas1.after(300, lambda: canvas1.delete(line_id))

def udate_path(value):
    global current_width
    current_width = float(value)
    for line in pen_lines:
        canvas1.itemconfig(line, width=current_width)

def stretch_tool(value):
    global stretch_val
    stretch_val = float(value)

#-----gui setup:
header = ttk.Frame(root)
header.grid(column=0, row=0, sticky='nswe')
header.columnconfigure(0, weight=1)

slider2 = ttk.Scale(header, from_=0.9, to=0.05, command=stretch_tool, style='scale1.Horizontal.TScale')
slider2.set(0.9)
slider2.grid(column=0, row=0, sticky='nswe', pady=5, padx=5)


canvas1 = tk.Canvas(root, background='#ff00e4', highlightthickness=0)
canvas1.grid(column=0, row=1, sticky='nswe')
canvas1.bind('<Enter>', save_pos)
canvas1.bind('<Motion>', draw_shape)

toolbar = ttk.Frame(root, style='frame1.TFrame')
toolbar.grid(column=0, row=2, sticky='we')
toolbar.columnconfigure(0, weight=1)
toolbar.columnconfigure(1, weight=1)
toolbar.columnconfigure(2, weight=1)
toolbar.columnconfigure(3, weight=1)
toolbar.columnconfigure(4, weight=1)

slider1 = ttk.Scale(toolbar, from_=3, to=20, command=udate_path)
slider1.set(3)
slider1.grid(column=0, row=0, sticky='we',padx=10)

radiobutton1 = ttk.Radiobutton(toolbar, text='pen', variable=tool_choice, value='pen')
radiobutton1.grid(column=1, row=0, sticky='we', pady=10, padx=10)

radiobutton2 = ttk.Radiobutton(toolbar, text='oval', variable=tool_choice, value='oval')
radiobutton2.grid(column=2, row=0, sticky='we',padx=5)

radiobutton3 = ttk.Radiobutton(toolbar, text='rectangle', variable=tool_choice, value='rect')
radiobutton3.grid(column=3, row=0, sticky='we',padx=5)

radiobutton4 = ttk.Radiobutton(toolbar, text='lines', variable=tool_choice, value='lines')
radiobutton4.grid(column=4, row=0, sticky='we',padx=5)

#-----------program start:
root.mainloop()