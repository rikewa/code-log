#-----functions
def export_ufo(character):

    if os.path.exists("MyFont.ufo"):
        font_ufo = ufoLib2.Font.open("MyFont.ufo")
    else:
        font_ufo = ufoLib2.Font()

    uni_code = ord(character)

    source_glyph_name = cmap.get(uni_code)

    if source_glyph_name is None:
        return

    source_glyph = glyph_set[source_glyph_name]

    if source_glyph_name in font_ufo:
        del font_ufo[source_glyph_name]

    glyph = font_ufo.newGlyph(source_glyph_name)

    point_pen = glyph.getPointPen()
    pen = SegmentToPointPen(point_pen)

    source_glyph.draw(pen)

    glyph.width = source_glyph.width

    font_ufo.save("MyFont.ufo")

