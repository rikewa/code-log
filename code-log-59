#-----functions:
def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, center_x, scale=0.3, offset_x=0, offset_y=0):
    x,y = pt
    x -= center_x
    y = -y 

    x *= scale
    y *= scale

    x += offset_x
    y += offset_y

    return x,y

def center_glyph(penData):
    points = []

    for befehl, punkte in penData:
        for pt in punkte:
            points.append(pt)

    x_punkte = []
    for p in points:
        x = p[0]
        x_punkte.append(x)
    min_x = min(x_punkte)
    max_x = max(x_punkte)
    return min_x, max_x

def draw_glyph(canvas1, penData, scale=0, offset_x = 0, offset_y=0):
    min_x, max_x = center_glyph(penData)
    center_x = (min_x + max_x)/2
    current = None
    starting = None
    lines = []

    if not penData:
        return lines
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]
            line_id = canvas1.create_line(transform(current, center_x, scale=scale, offset_x=offset_x, offset_y=offset_y), transform(new, center_x,scale=scale, offset_x=offset_x, offset_y=offset_y), fill='#00ff00')
            lines.append(line_id)
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 40
            prev = current
            for i in range(1, steps+1):
                progress = i/steps
                curve_points = cubic_bezier(current, p1, p2, p3, progress)
                line_id = canvas1.create_line(transform(prev, center_x, scale=scale, offset_x=offset_x, offset_y=offset_y), transform(curve_points, center_x, scale=scale, offset_x=offset_x, offset_y=offset_y),fill='#00ff00')
                lines.append(line_id)
                prev = curve_points
            current = p3
        elif befehl == 'closePath':
            if starting is not None and current is not None:
                line_id = canvas1.create_line(transform(current, center_x,scale=scale, offset_x=offset_x,offset_y=offset_y), transform(starting, center_x,scale=scale, offset_x=offset_x,offset_y=offset_y),fill='#00ff00')
                lines.append(line_id)
    for line in lines:
        canvas1.itemconfig(line, width=current_width)
    return lines

def render_glyph(character):
    if not character or cmap is None:
        return 
    
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code)

    if glyph_name is None:
        return None

    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value

def load_font():
    global font_path, font, cmap, glyph_set

    try:
        font_path = 'assets/fonts/artificiel-testing.otf'
        font = TTFont(font_path)
        glyph_set = font.getGlyphSet()
        cmap = font.getBestCmap()

    except Exception as e:
        print('no Font found', e)

def drawing_action(event = None):
    selection = glyphList.curselection()
    sizeScale.configure(state='disabled')
    slider1.configure(state='disabled')
    slider2.configure(state='disabled')
    draw_mode = 'glyph'

    if not selection:
        return
    
    input_value = glyphList.get(selection[0])
    canvas1.delete('all')

    penData = render_glyph(input_value)
    if penData:
        draw_glyph(canvas1, penData, offset_x=170, offset_y=370, scale=0.3)

def draw_text(text):
    global current_lines, spacing, line_height, text_scale
    current_lines = []
    x_start = 160 * text_scale/ 0.3
    y_start = 300 * text_scale/ 0.3
    scale_start = text_scale


    for character in text:
        if character == '|':
            x_start = 160 * text_scale/ 0.3
            y_start += line_height * text_scale/ 0.3
            continue

        penData = render_glyph(character)
        if not penData:
            continue
        glyph_name = cmap.get(ord(character), cmap.get(ord('?')))
        advanced_width,_ = font['hmtx'][glyph_name]
        lines = draw_glyph(canvas1, penData, scale=scale_start, offset_x = x_start, offset_y = y_start)
        current_lines.extend(lines)

        x_start += advanced_width * scale_start * spacing

def update_spacing(value):
