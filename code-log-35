#--------functions:
def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def tranform_to_canvas(pt, scale=0.4, offset_x= 40, offset_y=300):
    x,y=pt
    y = -y

    x*= scale
    y*= scale

    x+=offset_x
    y+=offset_y

    return(x,y)

def draw_curve(canvas1, glyph_data):
    canvas1.delete('all')

    if not glyph_data:
        return

    current = None

    for befehl, punkte in glyph_data:
        if befehl == 'moveTo':
            current = punkte[0]

        elif befehl == 'lineTo':
            new = punkte[0]
            canvas1.create_line(tranform_to_canvas(current), tranform_to_canvas(new))
            current = new

        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 100
            prev = current

            for i in range(1, steps +1):
                progress = i /steps
                curve_point = cubic_bezier(current, p1, p2,p3, progress)
                canvas1.create_line(tranform_to_canvas(prev), tranform_to_canvas(curve_point))
                prev = curve_point

            current = p3

        elif befehl == 'closePath':
            pass

def render_glyph(character):
# bei leerer eingabe:
    if not character:
        return[]
# hier wird das erste zeichen aus dem eingegeben string genommen [0]
# ord gibt hier die unicode nummer des zeichens zurück:
    unicode = ord(character[0])
#cmap übergibt mithilfe der unicode nummer den glyphen namen (übersetzungstabelle)
    glyph_name = cmap.get(unicode, cmap.get(ord('a')))
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value
    

 
