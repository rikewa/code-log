root= tk.Tk()
root.geometry('300x450')
root.configure(bg='#00ff00')
root.title('psssssst')

label1= tk.Label(root, text='tell me your secret :–)', justify='left', background='#00ff00', 
                 foreground='#ff00e4',font=('continua', 10))
label1.pack(pady=5)

entry1= ttk.Entry(root, width=20, justify='center', font=('continua', 10))
entry1.pack(pady=15)
entry1.insert(0, 'type here')

style = ttk.Style()
style.theme_use('clam')
style.configure('button.TButton', background='#ff00e4', foreground='#00ff00', font=('continua', 10))
style.map('button.TButton', background=[('active','#00ff00')], foreground=[('active', '#ff00e4')])

button1= ttk.Button(root, text='delete', command=delete_input, style='button.TButton', cursor='hand2')
button1.pack(pady=5)

button2 = ttk.Button(root, text='send', command=send_input, style='button.TButton', cursor='hand2')
button2.pack()

button3 = ttk.Button(root, text='close :-(', command=root.destroy, style='button.TButton', cursor='hand2')
button3.pack(pady=5, side='bottom')

root.mainloop()