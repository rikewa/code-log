#--------------------- functions

def run_timer():
    global timer_running, timer
    errorLabel.configure(text='')

    if timer == 0: 
        try:
            timer = int(hourString.get())*3600 + int(minuteString.get())*60 + int(secondString.get())
        except:
            errorLabel.configure(text='only numbers :-(')
            hourString.set('00')
            minuteString.set('60')
            secondString.set('00')
            return
        
        if timer == 0:
            messagebox.showinfo('', 'time is over!')
            timer_running = None

            hourString.set('00')
            minuteString.set('60')
            secondString.set('00')
            return
    
    def countdown():
        global timer_running, timer
#hier wird der eingegebene wert des entries um 1 subtrahiert
        timer -= 1

        totalhours, rest = divmod(timer, 3600)
        totalminutes, seconds = divmod(rest, 60)
        totalseconds = seconds

#formatierung der oben berechneten integer werte in strings
        hourString.set(f'{totalhours:02d}')
        minuteString.set(f'{totalminutes:02d}')
        secondString.set(f'{totalseconds:02d}')

        if timer==0:
            messagebox.showinfo('', 'time is over')
            timer_running = None

            hourString.set('00')
            minuteString.set('60')
            secondString.set('00')
            return
        
# root.after führt die countdown funktion alle 1000millisekunden aus(1sek)
# wenn der wert auf 0 fällt wird if funktion ausgeführt
# durch die variable timer_running wird sich der aktuelle wert gemerkt und ich kann die später nocheinmal ansprechen
        timer_running= root.after(1000, countdown)
    countdown()

def pause_timer():
    global timer_running 

    if timer_running is not None:
        root.after_cancel(timer_running)
        timer_running = None

def stop_timer():
    global timer_running, timer

    if timer_running is not None:
        root.after_cancel(timer_running)
        timer_running = None

    timer = 0

    hourString.set('00')
    minuteString.set('60')
    secondString.set('00')
    return
