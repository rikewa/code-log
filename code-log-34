#-------bezier helper: 
def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform_point(pt, scale=0.3, offset_x=60, offset_y=180):
    x, y = pt
    y = -y

    x*= scale
    y*=scale

    x += offset_x 
    y += offset_y

    return(x, y)

#------------ drawing function:
def draw_bezier(canvas, penData):
    current = None

    for befehl, punkte in penData:
        if befehl == 'moveTo':
# current wird hier zugewiesen
            current = punkte[0]
        elif befehl == 'lineTo':
# neuer Punkt
            new = transform_point(punkte[0])
# zwischen current und neuer punkt wird linie gezeichnet
            canvas.create_line(current, new)
# current wird aktualisiert
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 20
            prev = current

            for i in range(1, steps +1):
                progress = i / steps
                curve_point = transform_point(cubic_bezier(current, p1, p2, p3, progress))
                canvas.create_line(prev, curve_point)
                prev = curve_point
                current = p3
        elif befehl == 'closePath':
            pass


