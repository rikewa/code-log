import tkinter as tk 
from tkinter import ttk 
import random
import string

# pink: #ff00e4 grün:#00ff00


root = tk.Tk()
root.title('title')
root.attributes('-topmost', True)
root.configure(pady=20, padx=20, background='#ff00e4')

current_letter = tk.StringVar(value='A')
running = False


#---------functions:
def start():
    global running
    running = True
    random_letter()

def stop():
    global running
    running = False

def random_letter():
    global running
    if running:
        letter = random.choice(string.ascii_uppercase)
        current_letter.set(letter)
        root.after(50, random_letter)
    #        root.after(1000, stop)


#------window settings
swidth = root.winfo_screenwidth()
sheight = root.winfo_screenheight()

width = int(swidth * 0.15)
height = int(sheight * 0.25)

position_x = int((swidth - width)/2)
position_y = int((sheight - height)/2)
root.geometry(f'{width}x{height}+{position_x}+{position_y}')
root.columnconfigure(0, weight=1)

#------style settings:
style = ttk.Style()
style.theme_use('alt')
style.configure('label1.TLabel', font=('', 150))

#-------program structure:

labelframe1 = ttk.LabelFrame(root, text='random')
labelframe1.grid(column=0, row=0, sticky='we')

label1 = ttk.Label(labelframe1, textvariable=current_letter, style='label1.TLabel', anchor='center', justify='center')
label1.grid(column=0, row=0, sticky='nswe')

frame1 = ttk.Frame(root)
frame1.grid(column=0, row=1)
frame1.columnconfigure(0, weight=1)

button1 = ttk.Button(frame1, text='start', command=start)
button1.grid(column=0, row=0)

button2 = ttk.Button(frame1, text='stop', command=stop)
button2.grid(column=0, row=1)

#--------program start:
root.mainloop()