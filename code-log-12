#___Timer Function:

def run_timer():
#error label clearen
    errorlabel.configure(text='')
    try:
        timer = int(hourString.get()) *3600 + int(minuteString.get()) * 60 + int(secondString.get())
    except Exception as e:
        print(e)
#hier label hinzufügen und timer zurücksetzen auf 00
        errorlabel.configure(text='invalid value')
        hourString.set('01')
        minuteString.set('00')
        secondString.set('00')
        return

    def countdown():
        global timer_running
        nonlocal timer
        timer -= 1
        
        totalHours, remainder = divmod(timer, 3600)
        totalMinutes, seconds = divmod(remainder, 60)
        totalSeconds = seconds

        hourString.set(f'{totalHours:02d}')
        minuteString.set(f'{totalMinutes:02d}')
        secondString.set(f'{totalSeconds:02d}')
        if (timer == 0):
            messagebox.showinfo('timer','time is over', parent=root)
            timer_running = None
            return
    
        timer_running = root.after(1000, countdown)
    countdown()

def stop_timer():
    global timer_running

    if timer_running is not None:
        root.after_cancel(timer_running)
        timer_running = None

    hourString.set('01')
    minuteString.set('00')
    secondString.set('00')
    return




