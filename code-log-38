def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, scale = 0.3, offset_x = 10, offset_y=320):
    x,y = pt
    y = -y

    x*= scale
    y*= scale

    x+=offset_x
    y+=offset_y

    return(x,y)

def draw_glyph(canvas1, penData):
    canvas1.delete('all')
    current = None
    starting = None

    if not penData:
        return
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current=punkte[0]
        if befehl == 'lineTo':
            new = punkte[0]
            canvas1.create_line(transform(current), transform(new), fill='#ff00e4')
            current = new
        if befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 50
            prev = current 
            for i in range(1, steps+1):
                process = i/steps
                curve_point = cubic_bezier(current, p1, p2, p3, process)
                canvas1.create_line(transform(curve_point), transform(prev), fill='#ff00e4')
        if befehl == 'closePath':
            if starting is not None and current is not None:
                canvas1.create_line(transform(current), transform(starting), fill='#ff00e4')
            current = starting

def render_glyph(character):
    if not character:
        return
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code, cmap.get(ord('a')))
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return(pen.value)

def show_infos(character):
    if not character:
        return
    
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code, 'unknown')
    info_var.set(f'{character} | {glyph_name} | {uni_code} [unicode]')

