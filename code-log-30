import tkinter as tk 
from tkinter import ttk 

# pink: #ff00e4 grün:#00ff00

root = tk.Tk()
root.title('PARTY')
root.attributes('-topmost', True)
root.configure(pady=10, padx=10, background='#00ff00')

switch_on = False
text_var = tk.StringVar()
text_var.set('OFF')

colors = ['#00ff00', '#ff00e4']
index = 0
index2 =1

running_party = False

style = ttk.Style()
style.theme_use('alt')
style.configure('label1.TLabel', background='#00ff00', foreground='#ff00e4', font = ('',15))

#-------window settings:
swidth = root.winfo_screenwidth()
sheight = root.winfo_screenheight()

width = int(swidth *0.16)
height = int(sheight * 0.26)

position_x = int((swidth - width)/2)
position_y = int((sheight - height)/2)

root.geometry(f'{width}x{height}+{position_x}+{position_y}')
root.columnconfigure(0, weight = 1)
root.columnconfigure(1, weight = 1)
#-------------
#--------style settings:


happy= ttk.Label(root, text='HAPPY 30 DAYS OF CODE', style='label1.TLabel')
happy.grid(column=0, columnspan=2, row=0, pady=5, padx=10)

canvas1 = tk.Canvas(root, background='#00ff00', highlightthickness=0, cursor='hand2')
canvas1.grid(column=0, row=1, columnspan=2, ipadx=10, pady=1)
#(x1, y1, x2, y2)
rec1 = canvas1.create_rectangle((20,10,100,30), width=0, fill='#ff00e4')
rec2 = canvas1.create_rectangle((20,170,100,190),width=0, fill='#ff00e4')
rec3 = canvas1.create_rectangle((50,80,100,100),width=0, fill='#ff00e4')
rec4 = canvas1.create_rectangle((90,30,110,80),width=0, fill='#ff00e4')
rec5 = canvas1.create_rectangle((90,100,110,170),width=0, fill='#ff00e4')
rec6 = canvas1.create_rectangle((140,30,160,170),width=0, fill='#ff00e4')
rec7 = canvas1.create_rectangle((150,10,220,30),width=0, fill='#ff00e4')
rec8 = canvas1.create_rectangle((150,170,220,190),width=0, fill='#ff00e4')
rec9 = canvas1.create_rectangle((210,30,230,170),width=0, fill='#ff00e4')


canvas2 = tk.Canvas(root, background='#00ff00', width=100, height=40, highlightthickness=0, cursor='hand2')
canvas2.grid(column=1, row=2,  sticky='w')

bg = canvas2.create_rectangle((10,10,90,30),fill='lightgrey', outline='#ff00e4')
knob = canvas2.create_rectangle((10,10,50,30),fill='#00ff00', outline='#ff00e4')
knob_text = canvas2.create_text((30,20), text=text_var.get(), fill='#ff00e4')

partyLabel = ttk.Label(root, text='party mode:', style='label1.TLabel')
partyLabel.grid(column=0, row=2,  sticky='e', pady=5)

#--------functions
def toggle_event(event):
    global switch_on, running_party

    switch_on = not switch_on
    running_party = switch_on

    canvas2.itemconfig(bg, fill='darkgrey')

    if switch_on:
        canvas2.coords(knob,50,10,90,30)
        canvas2.coords(knob_text, 70,20)
        canvas2.itemconfig(bg, fill='#ff00e4')
        text_var.set('ON')
        party()
    
    else:
        canvas2.coords(knob,10,10,50,30)
        canvas2.coords(knob_text, 30,20)
        canvas2.itemconfig(bg, fill='lightgrey')
        text_var.set('OFF')

        canvas1.configure(bg='#00ff00')
        root.configure(bg='#00ff00')
        canvas2.configure(bg='#00ff00')
        for rec in [rec1, rec2, rec3, rec4, rec5, rec6, rec7, rec8, rec9]:
            canvas1.itemconfigure(rec, fill = colors[index2])

    
    canvas2.itemconfig(knob_text, text=text_var.get())
    canvas2.tag_raise(knob)
    canvas2.tag_raise(knob_text)


def party():
    global index, index2

    if not running_party:
        return
    
    root.configure(bg=colors[index])
    canvas1.configure(bg=colors[index])
    canvas2.configure(bg=colors[index])

    for rec in [rec1, rec2, rec3, rec4, rec5, rec6, rec7, rec8, rec9]:
        canvas1.itemconfigure(rec, fill = colors[index2])

    index = (1 - index) % len(colors)

    root.after(100, party)
party()





canvas2.tag_bind(bg, '<Button-1>', toggle_event)
canvas2.tag_bind(knob, '<Button-1>', toggle_event)
canvas2.tag_bind(knob_text, '<Button-1>', toggle_event)


#-----program start:
root.mainloop()