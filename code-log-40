def change_stroke(value):
    for lines in current_line:
        canvas1.itemconfig(lines, width=float(value))

def create_shape(canvas1, p1, p2):
    x1, y1 = transform(p1)
    x2, y2 = transform(p2)

    mode = current_shape.get()

    if mode == 'oval':
        return canvas1.create_oval(x1, y1, x2, y2, fill='#ff00e4', outline="#ff00e4", width=0)
    
    elif mode == 'line':
        return canvas1.create_line(x1, y1, x2, y2, fill='#ff00e4')
    
    elif mode == 'rectangle':
        return canvas1.create_rectangle(x1, y1, x2, y2, fill='#ff00e4', outline="#ff00e4", width=0)


def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, scale=0.3, offset_x=30, offset_y=300):
    x,y = pt
    y = -y

    x *= scale
    y *= scale

    x += offset_x
    y += offset_y

    return(x,y)

def draw_glyph(canvas1, penData):
    canvas1.delete('all')
    current = None
    starting = None
    lines=[]

    if not penData:
        return lines
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]
            line_id = create_shape(canvas1, current, new)
            lines.append(line_id)
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 10
            prev = current
            for i in range(1, steps+1):
                process = i/steps
                curve_point = cubic_bezier(current, p1, p2, p3, process)
                line_id = create_shape(canvas1, prev, curve_point)
                lines.append(line_id)
                prev = curve_point
            current = p3
        elif befehl == 'closePath':
            if starting is not None and current is not None:
                line_id= create_shape(canvas1, current, starting)
                lines.append(line_id)
    return lines
    
def render_glyph(character):
    if not character:
        return
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code, cmap.get(ord('a')))
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)

    return pen.value

def show_info(character):
    if not character:
        return
    uni_code = ord(character)
    glyph_name= cmap.get(uni_code, 'unknown')
    info_var.set(f'{glyph_name} | {uni_code} [unicode]')


