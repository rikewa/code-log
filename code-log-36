#-------fuctions:
def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def tranform(pt, scale=0.3, offset_x= 70, offset_y=270):
    x,y = pt 
    y = -y

    x *= scale
    y *= scale

    x += offset_x
    y += offset_y

    return(x,y)

def draw_glyph(canvas1, glyph_data):
    canvas1.delete('all')

    current = None

    if not glyph_data:
        return
    
    for befehl, punkte in glyph_data:
        if befehl == 'moveTo':
            current = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]
            canvas1.create_line(tranform(current), tranform(new))
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 50
            prev = current  
            for i in range(1, steps +1):
                progress = i/steps
                curve_point = cubic_bezier(current, p1, p2, p3, progress)
                canvas1.create_line(tranform(prev), tranform(curve_point))
                prev = curve_point
            current = p3

        elif befehl == 'closePath':
            pass

def render_Glyph(character):

    if not character:
        return
    u_code = ord(character[0])
    glyph_name = cmap.get(u_code, cmap.get(ord('a')))
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value


def show_details(character):
    if not character:
        return
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code, 'unknown')
    glyph_details.set(f'{character} | unicode: {uni_code} | {glyph_name}')

