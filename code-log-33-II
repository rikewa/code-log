import tkinter as tk 
from tkinter import ttk 
import random
import string

# pink: #ff00e4 grün:#00ff00


root = tk.Tk()
root.title('Letterizor')
root.attributes('-topmost', True)
root.configure(pady=25, padx=25, background='#ff00e4')

current_letter = tk.StringVar(value='A')
start_stop = tk.StringVar()
start_stop.set('start')
running = False
values =['start', 'stop']

#---------functions:
def toggle():
    global running

    running = not running

    if running:
        random_letter()
        start_stop.set('stop')
    else:
        start_stop.set('start')

def random_letter():
    global running

    if running:
        letter = random.choice(string.ascii_uppercase)
        current_letter.set(letter)
        root.after(50, random_letter)
#        root.after(1000, stop) 

#------window settings
swidth = root.winfo_screenwidth()
sheight = root.winfo_screenheight()

width = int(swidth * 0.13)
height = int(sheight * 0.3)

position_x = int((swidth - width)/2)
position_y = int((sheight - height)/2)
root.geometry(f'{width}x{height}+{position_x}+{position_y}')
root.columnconfigure(0, weight=1)

#------style settings:
style = ttk.Style()
style.theme_use('alt')
style.configure('label1.TLabel', font=('', 180))
style.configure('button1.TButton', borderwidth = 10, relief = 'sunken')
style.map('button1.TButton', background =[('pressed','#ff00e4')])

#-------program structure:

labelframe1 = ttk.LabelFrame(root)
labelframe1.grid(column=0, row=0, sticky='we')
labelframe1.columnconfigure(0, weight=1)

label1 = ttk.Label(labelframe1, textvariable=current_letter, style='label1.TLabel', anchor='center', justify='center')
label1.grid(column=0, row=0, sticky='we')

button1 = ttk.Button(root, textvariable=start_stop, command=toggle, style='button1.TButton')
button1.grid(column=0, row=1, pady=10, sticky='we')


button1.bind('<Enter>', lambda e: button1.configure(cursor='hand1'))
button1.bind('<Leave>', lambda e: button1.configure(cursor='hand2'))
root.bind('<Enter>', lambda e: root.configure(cursor='man'))

#--------program start:
root.mainloop()