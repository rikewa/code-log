#------funktions:
def center_glyph(penData):
    points = []
    for befehl, punkte in penData:
        for pt in punkte:
            points.append(pt)

    x_punkte = []
    for punkte in points:
        x = punkte[0]
        x_punkte.append(x)
    min_x = min(x_punkte)
    max_x = max(x_punkte)
    return min_x, max_x

def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def tranform(pt, center_x, scale=0.15, offset_x=0, offset_y=0):
    x,y = pt
    x -= center_x
    y = -y

    x,y = apply_effects((x,y))

    x *= scale
    y *= scale

    x += offset_x
    y += offset_y

    return x,y 

def draw_glyph(canvas1, penData, offset_x=0, offset_y = 0):
 #   canvas1.delete('all')
    min_x, max_x  = center_glyph(penData)
    center_x = (min_x + max_x)/2
    current = None
    starting = None
    lines = []


    if not penData:
        return lines
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        elif befehl == 'lineTo':
            new = punkte[0]
            line_id = canvas1.create_line(tranform(current, center_x, offset_x=offset_x, offset_y=offset_y), tranform(new, center_x,offset_x=offset_x, offset_y=offset_y), smooth=True, joinstyle='round', capstyle='round',fill='#ff00e4')
            lines.append(line_id)
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 50
            prev = current
            for i in range(1, steps+1):
                progress = i/steps
                curve_points = cubic_bezier(current, p1, p2, p3, progress)
                line_id = canvas1.create_line(tranform(prev, center_x,offset_x=offset_x,offset_y=offset_y), tranform(curve_points, center_x,offset_x=offset_x,offset_y=offset_y),smooth=True, joinstyle='round', capstyle='round', fill='#ff00e4')
                lines.append(line_id)
                prev = curve_points
            current = p3
        elif befehl == 'closePath':
            if starting is not None and current is not None:
                line_id = canvas1.create_line(tranform(current, center_x,offset_x=offset_x,offset_y=offset_y), tranform(starting, center_x,offset_x=offset_x,offset_y=offset_y),smooth=True, joinstyle='round', capstyle='round',fill='#ff00e4')
                lines.append(line_id)
    for line in lines:
        canvas1.itemconfig(line, width= current_width)
    return lines

def draw_text(text):
    global current_lines, spacing, line_height
    current_lines = []
    x_start = 80
    y_start = 150

    for character in text:
        if character == '|':
            x_start = 80
            y_start += line_height
            continue

        penData = render_glyph(character)
        if not penData:
            continue
        glyph_name = cmap.get(ord(character), cmap.get(ord('a')))
        advanced_width, _ = font['hmtx'][glyph_name]
        lines = draw_glyph(canvas1, penData, offset_x=x_start, offset_y=y_start)
        current_lines.extend(lines)

        x_start += advanced_width * spacing


def render_glyph(charakter):
    if not charakter:
        return
    
    uni_code = ord(charakter)
    glyph_name = cmap.get(uni_code, cmap.get(ord('a')))
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value

def borderwidth(value):
    global current_width, current_lines
    current_width = float(value)
    for line in current_lines:
        canvas1.itemconfig(line, width=current_width)

def change_steps(value):
    value = float(value)
    step_value = round(value/0.2)*0.2
    step_var.set(step_value)
    drawing_button

def update_spacing(value):
    global spacing
    spacing = float(value)
    drawing_button()

def update_line_height(value):
    global line_height
    line_height = float(value)
    drawing_button()


    
#----effect functions:

def effect(pt):
    x,y = pt
    return (x,y)

def apply_effects(pt):
    x,y = pt

    for effect in effects:
        x,y = effect((x,y))
    return (x,y)

def noise(pt):
    x,y = pt

    x += random.uniform(-noise_stren, noise_stren)
    y += random.uniform(-noise_stren, noise_stren)
    return(x,y)
def update_noise(value):
    global noise_stren
    noise_stren = float(value)
    drawing_button()

def wave(pt):
    x,y = pt
    y += math.sin(x * wave_freq) * wave_stren
    return(x,y)

def update_wave(value):
    global wave_stren
    wave_stren = float(value)
    drawing_button()

def update_wave_freq(value):
    global wave_freq
    wave_freq = float(value)
    drawing_button()

def scale_effect(pt):
    x,y = pt
    return(x*scale,y*scale)

def update_scale(value):
    global scale
    scale = float(value)
    drawing_button()

effects = [noise, wave, scale_effect]

