def drawing_button():
    input_value = entry1.get()
    draw_text(input_value)

def distort_point(x, y, mouse_x, mouse_y):
    radius = 300

    dx = x - mouse_x
    dy = y - mouse_y

    distance = (dx*dx + dy*dy) ** 0.5

    if distance < radius:
        force = 1 - distance / radius

        x += dx * force * 0.5
        y += dy * force * 0.5

    return x, y
        
def mouse_move(event):

    canvas1.delete("all")

    for p1, p2 in original_points:

        x1, y1 = distort_point(
            p1[0],
            p1[1],
            event.x,
            event.y
        )

        x2, y2 = distort_point(
            p2[0],
            p2[1],
            event.x,
            event.y
        )

        canvas1.create_line(
            x1, y1,
            x2, y2,
            width=current_width
        )

