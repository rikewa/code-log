#-------functions:
def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, scale=0.3, offset_x=0, offset_y=0):
    x, y = pt
    y = -y
    x *= scale
    y *= scale
    x += offset_x
    y += offset_y
    return x, y

def draw_glyph(canvas1, penData, scale=0.0, offset_x=0, offset_y=0):
    global original_points         
    current = None
    starting = None
    lines = []

    if not penData:
        return []
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
            tx, ty = transform(current, scale=scale, offset_x=offset_x, offset_y=offset_y)
            original_points.append((tx, ty)) 

        elif befehl == 'lineTo':
            new = punkte[0]
            line_id = draw_shape(current, new, scale=scale, offset_x=offset_x, offset_y=offset_y)
            lines.append(line_id)
            tx, ty = transform(new, scale=scale, offset_x=offset_x, offset_y=offset_y)
            original_points.append((tx, ty)) 
            current = new

        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = int(step_var.get())
            prev = current
            for i in range(1, steps + 1):
                progress = i / steps
                curve_point = cubic_bezier(current, p1, p2, p3, progress)
                line_id = draw_shape(prev, curve_point, scale=scale, offset_x=offset_x, offset_y=offset_y)
                lines.append(line_id)
                tx, ty = transform(curve_point, scale=scale, offset_x=offset_x, offset_y=offset_y)
                original_points.append((tx, ty))
                prev = curve_point
            current = p3

        elif befehl == 'closePath':
            if starting is not None and current is not None:
                line_id = draw_shape(current, starting, scale=scale, offset_x=offset_x, offset_y=offset_y)
                lines.append(line_id)
    
    for line in lines:
        canvas1.itemconfig(line, width=current_width)
    return lines

def render_glyph(character):
    if not character or cmap is None:
        return
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code)
    if glyph_name is None:
        return
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value

def draw_shape(p1, p2, scale=0.3, offset_x=0, offset_y=0):
    x1, y1 = transform(p1, scale=scale, offset_x=offset_x, offset_y=offset_y)
    x2, y2 = transform(p2, scale=scale, offset_x=offset_x, offset_y=offset_y)
    modus = shape_choice.get()
    offset = offset_var.get()

    if modus == 'vector':
        return canvas1.create_line(x1, y1, x2, y2, fill='#ff00e4')
    elif modus == 'oval':
        return canvas1.create_oval(x1 - offset, y1 - offset, x2 + offset, y2 + offset, fill='#ff00e4')
    elif modus == 'rectangle':
        return canvas1.create_rectangle(x1 - offset, y1 - offset, x2 + offset, y2 + offset, fill='#ff00e4')

def draw_text(text):
    global current_lines, line_height, spacing, text_scale, original_points
    canvas1.delete('all')
    current_lines = []
    original_points = []               
    x_start = 50 * text_scale / 0.3
    y_start = 250 * text_scale / 0.3
    scale_start = text_scale

    for character in text:
        if character == '|':
            x_start = 50 * text_scale / 0.3
            y_start += line_height * text_scale / 0.3
            continue
        penData = render_glyph(character)
        if not penData:
            continue
        glyph_name = cmap.get(ord(character), cmap.get(ord('?')))
        advanced_width, _ = font['hmtx'][glyph_name]
        lines = draw_glyph(canvas1, penData, scale=scale_start, offset_x=x_start, offset_y=y_start)
        current_lines.append(lines)
        x_start += advanced_width * text_scale * spacing

def distort_points(mouse_x, mouse_y):
    distorted = []
    radius = 300

    for original_x, original_y in original_points:
        dx = original_x - mouse_x
        dy = original_y - mouse_y
        distort = (dx * dx + dy * dy) ** 0.5
        x, y = original_x, original_y

        if distort < radius:
            force = 1 - (distort / radius)
            x += dx * force * 0.5
            y += dy * force * 0.5
        distorted.append((x, y))

    return distorted

def mouse_move(event):
    if not original_points:
        return
    canvas1.delete('all')
    distorted = distort_points(event.x, event.y)

    for i in range(len(distorted) - 1):
        p1 = distorted[i]
        p2 = distorted[i + 1]
        draw_shape_direct(p1, p2)

def mouse_enter(event):
    global mouse_on_canvas
    mouse_on_canvas = True

def mouse_leave(event):
    global mouse_on_canvas
    mouse_on_canvas = False

def draw_shape_direct(p1, p2):
    x1, y1 = p1
    x2, y2 = p2
    modus = shape_choice.get()
    offset = offset_var.get()

    if modus == 'vector':
        canvas1.create_line(x1, y1, x2, y2, smooth=True, joinstyle='round', capstyle='round', fill='#ff00e4')
    elif modus == 'oval':
        canvas1.create_oval(x1 - offset, y1 - offset, x2 + offset, y2 + offset, fill='#ff00e4')
    elif modus == 'rectangle':
        canvas1.create_rectangle(x1 - offset, y1 - offset, x2 + offset, y2 + offset, fill='#ff00e4')

def load_font():
    global font, font_path, cmap, glyph_set
    try:
        font_path = 'assets/fonts/artificiel-testing.otf'
        font = TTFont(font_path)
        glyph_set = font.getGlyphSet()
        cmap = font.getBestCmap()
    except Exception as e:
        print('no Font found', e)

def update_scale(value):
    global text_scale
    text_scale = float(value)
    drawing_button()

def update_line_height(value):
    global line_height
    line_height = float(value)
    drawing_button()

def update_spacing(value):
    global spacing
    spacing = float(value)
    drawing_button()

def update_steps(value):
    val = float(value)
    step_value = round(val / 0.2) * 0.2
    step_var.set(step_value)
    drawing_button()

def drawing_button():
    if mouse_on_canvas:
        return  
    input_value = entry1.get()
    draw_text(input_value)

def update_offset(value):
    if mouse_on_canvas:
        canvas1.delete('all')
        for i in range(len(original_points) - 1):
            draw_shape_direct(original_points[i], original_points[i + 1])
    else:
        drawing_button()

