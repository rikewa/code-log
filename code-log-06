#um einen text an eine variable zu binden wird statt text textvariable verwendet
#das geht aber nur mit einer text variable:

text_variable = tk.StringVar()
#python variable greift auf das Objekt StringVar zurück
text_variable.set('Hello World')

int_variable = tk.IntVar()
int_variable.set('10')

double_variable = tk.DoubleVar()
double_variable.set('1.5')

boolean_variable = tk.BooleanVar()
boolean_variable.set(False)

label1= ttk.Label(root, textvariable=text_variable, font=('continua', 50))
label1.pack()

label2= ttk.Label(root, textvariable=int_variable, font=('continua', 50))
label2.pack()

label3= ttk.Label(root, textvariable=double_variable, font=('continua', 50))
label3.pack()

label4= ttk.Label(root, textvariable=boolean_variable, font=('continua', 50))
label4.pack()

#ich kann immmer den text aktualieren und den text dynamisch machen
#hilfreich bei buttons (before/after klick)

print(text_variable.get())
print(int_variable.get())
print(double_variable.get())
print(boolean_variable.get())

root.mainloop()
