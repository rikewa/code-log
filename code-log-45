#-----functions:
def cubic_bezier(p0, p1, p2, p3, progress):
    return (
        (1-progress)**3 * p0[0] +
        3*(1-progress)**2 * progress * p1[0] +
        3*(1-progress) * progress**2 * p2[0] +
        progress**3 * p3[0],

        (1-progress)**3 * p0[1] +
        3*(1-progress)**2 * progress * p1[1] +
        3*(1-progress) * progress**2 * p2[1] +
        progress**3 * p3[1]
    )

def transform(pt, center_x, scale = 0.25, offset_x=175, offset_y=300):
    x,y = pt 
    x -= center_x
    y = -y

    x,y = apply_effect((x,y))

    x *= scale
    y *= scale

    x += offset_x
    y += offset_y

    return(x,y)

def draw_glyph(canvas1, penData):
    canvas1.delete('all')
    min_x, max_x = centerglyph(penData)
    center_x = (min_x + max_x)/2
    current = None
    starting = None
    lines = []

    if not penData:
        return lines
    
    for befehl, punkte in penData:
        if befehl == 'moveTo':
            current = punkte[0]
            starting = punkte[0]
        elif befehl == 'lineTo':
            new = punkte [0]
            line_id = shape(canvas1, current, new, center_x)
            lines.append(line_id)
            current = new
        elif befehl == 'curveTo':
            p1, p2, p3 = punkte
            steps = 20
            prev = current
            for i in range(1, steps+1):
                process = i/steps
                curve_points = cubic_bezier(current, p1, p2, p3, process)
                line_id = shape(canvas1, prev, curve_points, center_x)
                lines.append(line_id)
                prev = curve_points
            current = p3
        elif befehl == 'closePath':
            if starting is not None and current is not None:
                line_id= shape(canvas1, current, starting, center_x)
                lines.append(line_id)
    
    for line in lines:
        canvas1.itemconfig(line, width=current_width)

    return lines

def render_glyph(character):
    if not character:
        return
    uni_code = ord(character)
    glyph_name = cmap.get(uni_code, cmap.get(ord('a')))
    glyph = glyph_set[glyph_name]
    pen = RecordingPen()
    glyph.draw(pen)
    return pen.value

def borderwidth(value):
    global current_width
    current_width = float(value)
    for line in current_lines:
        canvas1.itemconfig(line, width = current_width)

def centerglyph(penData):
    points = []

    for befehl, punkte in penData:
        for pt in punkte:
            points.append(pt)

    x_punkte = []
    for p in points:
        x = p[0]
        x_punkte.append(x)
    min_x = min(x_punkte)
    max_x = max(x_punkte)

    return min_x, max_x

def shape(canvas1, p1, p2, center_x):
    x1, y1 = transform(p1, center_x)
    x2, y2 = transform(p2, center_x)

    mode = shape_choice.get()

    if mode == 'line':
        return canvas1.create_line(x1, y1, x2, y2, smooth = True, joinstyle ='round', capstyle='round')
    elif mode == 'oval':
        return canvas1.create_oval(x1, y1, x2, y2)
    elif mode == 'rect':
        return canvas1.create_rectangle(x1, y1, x2, y2)
    
#--------effect functions:
def effect(pt):
    x,y =pt
    return(x,y)

def apply_effect(pt):
    x,y = pt
    for effect in effects:
        x,y = effect((x,y))
    return(x,y)

def wave(pt):
    x,y = pt
    y+= math.sin(x * wave_freq) * wave_strength
    return(x,y)
def update_wave(value):
    global wave_strength
    wave_strength = float(value)
    drawing_button()    
def update_wave_freq(value):
    global wave_freq
    wave_freq = float(value)
    drawing_button()

def noise(pt):
    x,y = pt

    x += random.uniform(-noise_strength, noise_strength)
    y += random.uniform(-noise_strength, noise_strength)
    return(x,y)
def update_noise(value):
    global noise_strength
    noise_strength = float(value)
    drawing_button()

def scale(pt):
    x,y = pt
    return(x*scale_strength,y*scale_strength)
def update_scale(value):
    global scale_strength
    scale_strength = float(value)
    drawing_button()

effects = [wave, noise, scale]

