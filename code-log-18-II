#-----------image import:
image1 = Image.open('assets/images/dog1.jpg')
image1.thumbnail((100,100))
photo1 = ImageTk.PhotoImage(image1)

image2 = Image.open('assets/images/cat1.jpg')
image2.thumbnail((100,100))
photo2 = ImageTk.PhotoImage(image2)

#---------Functions:

#-------progressbar 1:
def next_Step():
    if bar1['value'] < 100:
        bar1['value'] +=10
        resetButton.configure(state='disabled')
    
    else: 
        button1.configure(state='disabled')
        resetButton.configure(state='normal', command= reset_bar)
        loadImage2.grid(column=0, row=1, pady=5)



def reset_bar():
    loadImage2.grid_remove()
    bar1['value'] = 0
    button1.configure(state='normal')
    resetButton.configure(state='disabled')
#-------------

#-------progressbar2:
def load_progress(): 
    for task in range(10):
        bar2['value']+= 10
        root.update()
        time.sleep(0.2)
        button2.config(state='disabled', text='loading')

        if bar2['value'] == 100:
            button2.configure(state='normal', text='again!', command=reload_progress)
            loadimage1.grid(column=0, row=4)
            


def reload_progress():
    loadimage1.grid_remove()
    bar2['value'] = 0
    button2.configure(state='normal', text='load', command=load_progress)
    

#---------------------

labelFrame1 = ttk.Labelframe(root, text='make progress today:', cursor='man')
labelFrame1.grid(column=0, row=0, sticky='we', pady=10)

resetButton = ttk.Button(labelFrame1, text='reset', state='disabled')
resetButton.grid(column=0, row=2, pady=3)

bar1 = ttk.Progressbar(labelFrame1, orient='horizontal', length=200, style='bar.Horizontal.TProgressbar')
bar1.grid(column=0,row=0, pady=5)

button1 = ttk.Button(labelFrame1, text='click', command=next_Step)
button1.grid(column=0, row=1)

loadImage2= ttk.Label(root, image=photo2)

#----------------------

bar2 = ttk.Progressbar(root, orient='horizontal', length=200, style= 'bar.Horizontal.TProgressbar')
bar2.grid(column=0, row=2)

button2 = ttk.Button(root, text='load', command=load_progress, cursor='hand2')
button2.grid(column=0, row=3, pady=5)

loadimage1 = ttk.Label(root, image=photo1)










root.mainloop()

