import tkinter as tk 
from tkinter import ttk
from PIL import Image, ImageTk
import time

# pink: #ff00e4 grün:#00ff00


root = tk.Tk()
root.title("Progress-Maker")
root.attributes('-topmost', True)
root.geometry('240x400')
root.configure(background='#ff00e4', pady=10, padx=10)


#--------Style
style = ttk.Style()
style.theme_use('alt')

style.configure('bar.Horizontal.TProgressbar', background='#00ff00')
