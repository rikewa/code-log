separator.grid(column=0, row=11, sticky='we', pady=10)



def load_bar():
    for task in range(10):
        bar2['value'] +=10
        root.update()
        time.sleep(0.5)
        reloadButton.configure(state='disabled')
    if bar2['value'] ==100:
        imageLabel.grid(column=0, row=15)
        reloadButton.configure(state='normal')
        button3.configure(state='disabled')


def reload_bar():
    bar2['value'] = 0
    button3.configure(state='normal')
    imageLabel.grid_remove()


reloadButton = ttk.Button(root, text='reload', state='disabled', command=reload_bar)
reloadButton.grid(column=0, row=14)

