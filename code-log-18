#-----------progressbar
def next_step():
    if bar1['value'] <100:
        bar1['value'] +=10
    else:
        button2.configure(text='done', state='disabled')
        resetButton.configure(state='normal')

def reset_bar():
    bar1['value'] = 0 
    button2.configure(text='progress', state='normal')

resetButton = ttk.Button(root, text='reset', state='disabled', command=reset_bar)
